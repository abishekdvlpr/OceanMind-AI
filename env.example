# --- PostgreSQL / PostGIS ---
PGUSER=argo_user
PGPASSWORD=111111
PGHOST=localhost
PGPORT=5432
PGDATABASE=argo_db
# Or override the whole connection string:
# DATABASE_URL=postgresql+psycopg2://argo_user:111111@localhost:5432/argo_db

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# --- Paths ---
ARGO_DATA_DIR=./data
CHROMA_PATH=./chroma_db

# --- SQL guard rails ---
SQL_DEFAULT_LIMIT=500
SQL_MAX_LIMIT=5000

# NOTE: GEMINI_API_KEY from the old _env_example is not used anywhere in this
# project. The LLM is served locally by Ollama.
